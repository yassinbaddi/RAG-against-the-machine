"""Simple semantic search using sentence embeddings."""
from pathlib import Path
import numpy as np
from sentence_transformers import SentenceTransformer
from src.models import Chunk

MODEL_NAME = "all-MiniLM-L6-v2"


def embed_chunks(chunks: list[Chunk]) -> np.ndarray:
    """Turn all chunks into vectors."""
    model = SentenceTransformer(MODEL_NAME)
    texts = [c.content for c in chunks]
    return model.encode(texts, normalize_embeddings=True)


def save_embeddings(vectors: np.ndarray, output_dir: str) -> None:
    np.save(Path(output_dir) / "embeddings.npy", vectors)


def load_embeddings(output_dir: str) -> np.ndarray | None:
    path = Path(output_dir) / "embeddings.npy"
    if not path.exists():
        return None
    return np.load(path)


def search_embeddings(query: str, vectors: np.ndarray, chunks: list[Chunk], k: int = 5) -> list[Chunk]:
    """Return the k most similar chunks to the query."""
    model = SentenceTransformer(MODEL_NAME)
    q_vec = model.encode([query], normalize_embeddings=True)[0]
    scores = vectors @ q_vec  # cosine similarity (vectors are normalized)
    top_idx = np.argsort(scores)[::-1][:k]
    return [chunks[i] for i in top_idx]
"""Local recall@k evaluation (for your own iteration only — not the grader)."""

from __future__ import annotations

import json
from pathlib import Path

from .models import AnsweredQuestion, MinimalSearchResults, MinimalSource

IOU_THRESHOLD = 0.05


def check_overlap(src1: MinimalSource, src2: MinimalSource) -> bool:
    """Return True if two sources are in the same file and overlap enough."""
    if src1.file_path != src2.file_path:
        return False

    start1, end1 = src1.first_character_index, src1.last_character_index
    start2, end2 = src2.first_character_index, src2.last_character_index

    intersection = max(0, min(end1, end2) - max(start1, start2) + 1)
    union = max(end1, end2) - min(start1, start2) + 1
    if union == 0:
        return False

    return (intersection / union) >= IOU_THRESHOLD


def load_answered_questions(dataset_path: Path) -> list[AnsweredQuestion]:
    """Load a ground-truth AnsweredQuestions dataset."""
    if not dataset_path.exists():
        raise FileNotFoundError(f"Dataset not found: {dataset_path}")

    with dataset_path.open("r", encoding="utf-8") as file:
        data = json.load(file)

    return [
        AnsweredQuestion(
            question_id=item["question_id"],
            question=item["question"],
            sources=[MinimalSource(**s) for s in item["sources"]],
            answer=item.get("answer", ""),
        )
        for item in data.get("rag_questions", [])
    ]


def load_search_results(path: Path) -> list[MinimalSearchResults]:
    """Load a StudentSearchResults JSON file."""
    if not path.exists():
        raise FileNotFoundError(f"Search results not found: {path}")

    with path.open("r", encoding="utf-8") as file:
        data = json.load(file)

    return [
        MinimalSearchResults(
            question_id=item["question_id"],
            question=item["question"],
            retrieved_sources=item["retrieved_sources"],
        )
        for item in data.get("search_results", [])
    ]


def recall_at_k(
    student_results: list[MinimalSearchResults],
    ground_truth: dict[str, list[MinimalSource]],
) -> float:
    """Average, over all questions, the share of correct sources retrieved."""
    per_question_recall: list[float] = []

    for result in student_results:
        gt_sources = ground_truth.get(result.question_id, [])
        if not gt_sources:
            continue

        found = sum(
            1
            for gt in gt_sources
            if any(check_overlap(ret, gt) for ret in result.retrieved_sources)
        )
        per_question_recall.append(found / len(gt_sources))

    if not per_question_recall:
        return 0.0
    return sum(per_question_recall) / len(per_question_recall)


def evaluate(student_search_results_path: str, dataset_path: str) -> str:
    """Compute recall@k of a student search-results file against ground truth."""
    student_results = load_search_results(Path(student_search_results_path))
    questions = load_answered_questions(Path(dataset_path))
    ground_truth = {q.question_id: q.sources for q in questions}

    score = recall_at_k(student_results, ground_truth)
    return f"{score * 100:.2f}%"
"""Answer generation using a small local causal language model (Qwen3-0.6B)."""

from __future__ import annotations

import textwrap
from typing import Any

from transformers import AutoModelForCausalLM, AutoTokenizer

from .models import Chunk

MODEL_NAME = "Qwen/Qwen3-0.6B"

_model_cache: dict[str, Any] = {}


def get_model_and_tokenizer() -> tuple[Any, Any]:
    """Lazily load and cache the tokenizer and model."""
    if "model" not in _model_cache:
        print("Loading model...")
        _model_cache["tokenizer"] = AutoTokenizer.from_pretrained(MODEL_NAME)
        _model_cache["model"] = AutoModelForCausalLM.from_pretrained(MODEL_NAME)
    return _model_cache["tokenizer"], _model_cache["model"]


def build_context(chunks: list[Chunk]) -> str:
    """Concatenate chunks into a single context block."""
    return "\n\n".join(
        f"--- SOURCE {i} ---\n{chunk.content}" for i, chunk in enumerate(chunks, start=1)
    )


def build_prompt(query: str, context: str) -> str:
    """Build the instruction prompt sent to the model."""
    return textwrap.dedent(
        f"""
        You are answering a question about the vLLM codebase.
        Use ONLY the following context to answer the question.
        If the context does not contain the answer, say so honestly.

        CONTEXT:
        {context}

        QUESTION:
        {query}

        ANSWER:
        """
    ).strip()


def generate_text(prompt: str, max_new_tokens: int = 256) -> str:
    """Generate text from a prompt using the cached model."""
    tokenizer, model = get_model_and_tokenizer()

    try:
        messages = [{"role": "user", "content": prompt}]
        text = tokenizer.apply_chat_template(
            messages,
            tokenize=False,
            add_generation_prompt=True,
            enable_thinking=False,
        )
    except (TypeError, ValueError, AttributeError):
        text = prompt

    inputs = tokenizer(text, return_tensors="pt").to(model.device)
    outputs = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=True,
        temperature=0.7,
    )

    input_length = inputs["input_ids"].shape[-1]
    new_tokens = outputs[0][input_length:]
    return tokenizer.decode(new_tokens, skip_special_tokens=True).strip()


def generate_answer(query: str, chunks: list[Chunk]) -> str:
    """Generate a grounded answer to a query from retrieved context chunks."""
    context = build_context(chunks)
    prompt = build_prompt(query, context)
    return generate_text(prompt)
